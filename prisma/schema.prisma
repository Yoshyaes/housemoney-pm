generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

enum ViewScope {
  PERSONAL
  WORKSPACE
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENT
  STATUS_CHANGE
  DEPENDENCY_RESOLVED
  AI_INSIGHT
}

enum InsightType {
  STALE_TASK
  OVERDUE_ESCALATION
  DEPENDENCY_UNBLOCKED
  WORKLOAD_IMBALANCE
  PROJECT_HEALTH_ALERT
  DUPLICATE_DETECTED
  DECOMPOSITION_SUGGESTED
  MEETING_ACTION_ITEMS
  DAILY_DIGEST
}

enum InsightStatus {
  PENDING
  ACCEPTED
  DISMISSED
  AUTO_APPLIED
  REVERTED
  EXPIRED
}

enum PRStatus {
  OPEN
  MERGED
  CLOSED
}

enum DocType {
  GENERAL
  MEETING_NOTES
  PLANNING
  RETROSPECTIVE
  DECISION_LOG
  EXPERIMENT
  RUNBOOK
}

enum DecisionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum ExperimentStatus {
  BACKLOG
  IN_PROGRESS
  COMPLETED
  ICEBOX
}

enum ExperimentPersona {
  RENTER
  HENRY
  FOUNDER
  FINANCE_BRO
  YOUNG_PERSON
  GLOBAL_TRAVELER
  LANDLORD
}

enum ExperimentChannel {
  FOUNDER_DM
  EMAIL
  TEXT
  PM_PARTNER
  REFERRAL
  TIKTOK
  TWITTER_X
  IG
  LINKEDIN
  IN_PERSON
  CHURCH_COMMUNITY
  PM_CONFERENCE
}

enum ExperimentType {
  DISCOVERY
  SMOKE_TEST
  FAKE_DOOR
  CONCIERGE
  WIZARD_OF_OZ
  MONEY_TEST
  AB_TEST
  GROWTH
  PM_PARTNER_WEDGE
  CUSTOMER_INTERVIEW
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  QUESTION
  OTHER
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id          String   @id // Matches Supabase auth.users.id
  email       String   @unique
  name        String
  avatarUrl   String?
  avatarColor String   @default("#BA7517") // Hex color for initials avatar
  notificationPrefs Json?    // { assigned: true, mentioned: true, comment: true, statusChange: true, ... }
  createdAt   DateTime @default(now())

  memberships        WorkspaceMember[]
  assignedTasks      Task[]           @relation("assignee")
  createdTasks       Task[]           @relation("creator")
  collaboratingTasks TaskCollaborator[]
  uploadedAttachments TaskAttachment[]
  comments           Comment[]
  docComments        DocumentComment[]  @relation("DocCommentAuthor")
  activities         Activity[]
  notifications      Notification[]   @relation("recipient")
  actedNotifications Notification[]   @relation("actor")
  views              View[]
  documents          Document[]       @relation("DocumentAuthor")
  lastEditedDocs     Document[]       @relation("DocumentLastEditor")
  createdProjects    Project[]        @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  sentInvitations    Invitation[]     @relation("InvitationSender")
  agentInsights      AgentInsight[]   @relation("InsightTarget")
  auditLogs          AuditLog[]
  createdDecisions   Decision[]       @relation("DecisionCreator")
  decisionParticipations DecisionParticipant[]
  createdExperiments Experiment[]     @relation("ExperimentCreator")
  ownedExperiments   Experiment[]     @relation("ExperimentOwner")
  uploadedDocAttachments DocumentAttachment[] @relation("DocAttachmentUploader")
  experimentComments ExperimentComment[] @relation("ExperimentCommentAuthor")
  createdFeedback    Feedback[]          @relation("FeedbackCreator")
  assignedFeedback   Feedback[]          @relation("FeedbackAssignee")
  feedbackComments   FeedbackComment[]   @relation("FeedbackCommentAuthor")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  taskCounter       Int      @default(0)
  experimentCounter Int      @default(0)
  feedbackCounter   Int      @default(0)
  createdAt         DateTime @default(now())

  projects      Project[]
  labels        Label[]
  members       WorkspaceMember[]
  views         View[]
  tasks         Task[]
  documents     Document[]
  invitations   Invitation[]
  agentInsights AgentInsight[]
  agentConfig   AgentConfig?
  auditLogs     AuditLog[]
  decisions     Decision[]
  experiments   Experiment[]
  feedback      Feedback[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#1D9E75") // Hex color for project dot
  targetDate  DateTime?
  isPrivate   Boolean       @default(false)
  createdById String?
  createdAt   DateTime      @default(now())

  tasks     Task[]
  sections  Section[]
  documents Document[]
  decisions   Decision[]
  experiments Experiment[]
  feedback    Feedback[]
  members     ProjectMember[]
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

model Task {
  id          String     @id @default(cuid())
  identifier  String     @unique // e.g. "HM-42"
  title       String
  description String?    // Markdown
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(NONE)
  workspaceId String
  projectId   String?
  sectionId   String?
  assigneeId  String?
  parentId    String?
  dueDate     DateTime?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  section       Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  assignee      User?        @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User         @relation("creator", fields: [createdById], references: [id])
  parent        Task?        @relation("subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks      Task[]       @relation("subtasks")
  labels        TaskLabel[]
  collaborators TaskCollaborator[]
  attachments   TaskAttachment[]
  comments      Comment[]
  activities    Activity[]
  blocking      Dependency[] @relation("blocking")
  blockedBy     Dependency[] @relation("blockedBy")
  notifications Notification[]
  githubPRs     GitHubPR[]
  agentInsights AgentInsight[]
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  name         String
  url          String
  size         Int?
  mimeType     String?
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

model TaskCollaborator {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Dependency {
  id             String   @id @default(cuid())
  blockingTaskId String
  blockedTaskId  String
  createdAt      DateTime @default(now())

  blockingTask Task @relation("blocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  Task @relation("blockedBy", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
}

model Comment {
  id          String   @id @default(cuid())
  taskId      String
  authorId    String
  body        String   // Markdown
  attachments Json?    // [{ name, url, size, mimeType }]
  reactions   Json?    // [{ emoji, userIds[] }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id])
  notifications Notification[]
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   // hex text color
  bgColor     String   // rgba background color
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Activity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  action    String   // "created", "status_changed", "assigned", "priority_changed", etc.
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model View {
  id          String    @id @default(cuid())
  workspaceId String
  ownerId     String
  name        String
  scope       ViewScope @default(PERSONAL)
  filters     Json      // [{ field, operator, value }]
  sort        Json      // [{ field, direction }]
  groupBy     String?
  swimlaneBy  String?
  displayType String    // "board" | "list" | "timeline"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  taskId       String?
  commentId    String?
  actorId      String
  message      String
  read         Boolean          @default(false)
  snoozedUntil DateTime?
  archivedAt   DateTime?
  createdAt    DateTime         @default(now())

  user    User     @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("actor", fields: [actorId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
}

model GitHubPR {
  id           String   @id @default(cuid())
  taskId       String
  githubId     Int      @unique // GitHub's globally unique PR id
  number       Int              // PR number within the repo
  repo         String           // "owner/repo"
  title        String
  url          String           // HTML URL to the PR
  status       PRStatus @default(OPEN)
  authorLogin  String           // GitHub username
  authorAvatar String?          // GitHub avatar URL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Document {
  id              String   @id @default(cuid())
  workspaceId     String
  authorId        String
  lastEditedById  String?
  title           String
  content         String   @default("") // Markdown string
  fileUrl         String?   // When set, this is a file-based document
  fileName        String?
  fileSize        Int?
  fileMimeType    String?
  docType         DocType  @default(GENERAL)
  tags            String[] // PostgreSQL text array
  projectId       String?  // Optional link to a project
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author       User              @relation("DocumentAuthor", fields: [authorId], references: [id])
  lastEditedBy User?             @relation("DocumentLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  docComments  DocumentComment[]
  attachments  DocumentAttachment[]

  @@index([workspaceId])
  @@index([workspaceId, docType])
}

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation("DocCommentAuthor", fields: [authorId], references: [id])

  @@index([documentId])
}

model DocumentAttachment {
  id           String   @id @default(cuid())
  documentId   String
  name         String
  url          String
  size         Int?
  mimeType     String?
  uploadedById String
  createdAt    DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("DocAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([documentId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(GUEST)
  projectIds  String[]
  invitedById String
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedById], references: [id])

  @@unique([workspaceId, email])
  @@index([token])
}

model AgentInsight {
  id             String        @id @default(cuid())
  workspaceId    String
  type           InsightType
  status         InsightStatus @default(PENDING)
  targetUserId   String?
  taskId         String?
  projectId      String?
  documentId     String?
  title          String
  body           String
  confidence     Float         @default(0.5)
  proposedAction Json?
  previousState  Json?
  digestId       String?
  expiresAt      DateTime?
  actedAt        DateTime?
  createdAt      DateTime      @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetUser User?     @relation("InsightTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type, status])
  @@index([targetUserId, status])
  @@index([workspaceId, createdAt])
}

model AgentConfig {
  id                 String  @id @default(cuid())
  workspaceId        String  @unique
  staleTaskDays      Int     @default(5)
  overdueEnabled     Boolean @default(true)
  digestEnabled      Boolean @default(true)
  digestHourUtc      Int     @default(13)
  duplicateCheck     Boolean @default(true)
  autoUnblock        Boolean @default(false)
  workloadAlerts     Boolean @default(true)
  decomposeThreshold Int     @default(500)
  maxInsightsPerDay  Int     @default(10)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String?
  email       String?
  action      String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([email, createdAt])
  @@index([action, createdAt])
}

// ─── Decisions ──────────────────────────────────────────

model Decision {
  id             String         @id @default(cuid())
  workspaceId    String
  title          String
  body           String         @default("")
  status         DecisionStatus @default(DRAFT)
  category       String?
  decisionDate   DateTime       @default(now())
  projectId      String?
  createdById    String
  supersededById String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User       @relation("DecisionCreator", fields: [createdById], references: [id])
  supersededBy Decision?  @relation("SupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Decision[] @relation("SupersededBy")
  participants DecisionParticipant[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, decisionDate])
}

model DecisionParticipant {
  decisionId String
  userId     String
  createdAt  DateTime @default(now())

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([decisionId, userId])
}

// ─── Experiments ────────────────────────────────────────

model Experiment {
  id              String             @id @default(cuid())
  identifier      String             @unique // e.g. "EXP-001"
  workspaceId     String
  projectId       String?
  createdById     String
  ownerId         String?

  // Identity
  title           String
  sprint          String?
  persona         ExperimentPersona?
  cohort          String?
  channel         ExperimentChannel?
  experimentType  ExperimentType?
  status          ExperimentStatus   @default(BACKLOG)

  // Hypothesis
  hypothesis         String          @default("")
  riskiestAssumption String?
  learningGoal       String?

  // Unit Economics
  cacEstimate     Float?
  monthlyArpu     Float?
  ltvEstimate     Float?
  paybackPeriod   Float?
  depositTarget   Float?

  // Scoring (8-criteria JSON + computed int)
  scoringCriteria Json?
  score           Int?

  // Execution
  startDate       DateTime?
  endDate         DateTime?
  resourceCost    String?
  testSize        String?

  // Success Measures
  primaryMetric          String?
  secondaryMetrics       String?
  killCondition          String?

  // Results
  whatHappened            String?
  primaryMetricResult    String?
  secondaryMetricResults String?
  unexpectedFindings     String?

  // Decisions
  didWeLearn             String?
  continueExperiment     String?
  continuePersona        String?
  nextAction             String?
  investorReadyInsight   String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User               @relation("ExperimentCreator", fields: [createdById], references: [id])
  owner           User?              @relation("ExperimentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  comments        ExperimentComment[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, persona])
}

model ExperimentComment {
  id           String   @id @default(cuid())
  experimentId String
  authorId     String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  author     User       @relation("ExperimentCommentAuthor", fields: [authorId], references: [id])

  @@index([experimentId])
}

// ─── Feedback ──────────────────────────────────────────

model Feedback {
  id           String         @id @default(cuid())
  identifier   String         @unique // e.g. "FB-001"
  workspaceId  String
  projectId    String?
  createdById  String
  assigneeId   String?

  title        String
  description  String         @default("")
  type         FeedbackType   @default(OTHER)
  status       FeedbackStatus @default(OPEN)
  priority     Priority       @default(NONE)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User           @relation("FeedbackCreator", fields: [createdById], references: [id])
  assignee     User?          @relation("FeedbackAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments     FeedbackComment[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author     User     @relation("FeedbackCommentAuthor", fields: [authorId], references: [id])

  @@index([feedbackId])
}
