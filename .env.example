# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# GitHub Integration
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Optional: comma-separated list of allowed repos (e.g. owner/repo1,owner/repo2)
# If set, webhook events from other repos will be silently ignored
GITHUB_ALLOWED_REPOS=

# Anthropic (AI Task Creation)
ANTHROPIC_API_KEY=your-anthropic-api-key
